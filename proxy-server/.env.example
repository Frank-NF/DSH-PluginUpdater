# 服务端口
PORT=8080

# GitHub Personal Access Token（可选，用于提高 API 限流）
# 申请地址: https://github.com/settings/tokens
GITHUB_TOKEN=

# 代理访问 Token（可选，配置后客户端必须携带 X-Proxy-Token 请求头）
PROXY_TOKEN=your-secret-proxy-token

# Redis 配置（用于缓存 GitHub API 响应，可选）
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# 缓存过期时间（分钟）
CACHE_TTL_MINUTES=30

# 允许的 GitHub 仓库白名单（逗号分隔，留空表示允许所有）
# 示例: DSH-Team/DSH-Agent,DSH-Team/dsh-plugin-example
ALLOWED_REPOS=
